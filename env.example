# ── App Config ─────────────────────────────────────
APP_NAME=vanwallet
APP_ENV=development
PORT=8080
APP_PORT=8080
ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ── Database Config ────────────────────────────────
# Render uses DATABASE_URL.
DATABASE_URL=

# Local fallback if DATABASE_URL is empty.
DB_USER=
DB_PASS=
DB_NAME=
DB_HOST=
DB_PORT=

# ── JWT Config ─────────────────────────────────────
JWT_ISSUER=vanwallet
JWT_SECRET=
JWT_EXPIRED=

# ── Redis Config Optional ──────────────────────────
# Render uses REDIS_URL.
REDIS_URL=

# Local fallback if REDIS_URL is empty.
RDB_ADDR=
RDB_USER=
RDB_PASS=

# Local fallback if REDIS_URL is empty.
RDB_ADDR=
RDB_USER=
RDB_PASS=

EMAIL_HOST=
EMAIL_PORT=
EMAIL_NAME=
EMAIL_PASS=

# ── Midtrans Config ────────────────────────────────
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# Optional redirect URL after customer completes Snap payment.
MIDTRANS_FINISH_URL=